# Database
# Local dev (docker-compose mssql service):
DATABASE_URL="sqlserver://localhost:14330;database=resume-builder;user=sa;password=YourStrong@Passw0rd;trustServerCertificate=true"

# Production (Azure SQL) — set this in Vercel's Environment Variables, not here:
# DATABASE_URL="sqlserver://<server-name>.database.windows.net:1433;database=<db-name>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=false;connectionTimeout=30"

# AI provider: "gemini" (Google AI Studio), "groq" (fast, free tier), or "ollama" (local, no API key)
AI_PROVIDER="gemini"

# Gemini (free tier via Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Groq (free tier via https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Ollama (local, requires `ollama serve` running and the model pulled)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:9b"

# OpenAI (optional, not currently used)
OPENAI_API_KEY=""

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_TEAM=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
