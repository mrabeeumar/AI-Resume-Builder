# Database
DATABASE_URL="sqlserver://localhost:1433;database=resume-builder;user=sa;password=YourStrong@Passw0rd;trustServerCertificate=true"

# Redis
REDIS_URL="redis://localhost:6379"

# AI provider: "gemini" (Google AI Studio), "groq" (fast, free tier), or "ollama" (local, no API key)
AI_PROVIDER="gemini"

# Gemini (free tier via Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Groq (free tier via https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Ollama (local, requires `ollama serve` running and the model pulled)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:9b"

# OpenAI (optional, not currently used)
OPENAI_API_KEY=""

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Email (verification + password reset, via Resend: https://resend.com/api-keys)
RESEND_API_KEY=""
# Default onboarding@resend.dev only delivers to your own Resend account email
# (sandbox restriction). To email real users, verify a domain in the Resend
# dashboard (Domains > Add Domain) and point EMAIL_FROM at that domain.
EMAIL_FROM="ResoVo <onboarding@resend.dev>"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_TEAM=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
