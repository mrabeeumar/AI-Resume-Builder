generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

model AtsReportCache {
  key       String   @id
  payload   String   @db.NVarChar(Max)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("ats_report_cache")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  resumes           Resume[]
  coverLetters      CoverLetter[]
  jobDescriptions   JobDescription[]
  subscription      Subscription?
  aiUsages          AIUsage[]
  aiJobs            AiJob[]
  conversations     Conversation[]
  interviewSessions InterviewSession[]
  jobApplications   JobApplication[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.NVarChar(Max)
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// SQL Server has no native enum support. Allowed values are enforced at the
// application layer — see lib/enums.ts for the canonical value lists.
// ResumeStatus: DRAFT | PUBLISHED | ARCHIVED
// ResumeTemplateId: CLASSIC | MODERN | MINIMAL
// ResumeThemeColor: SLATE | BLUE | EMERALD | ROSE
// ResumeSectionType: PERSONAL_INFO | SUMMARY | EXPERIENCE | EDUCATION | SKILLS
//   | PROJECTS | CERTIFICATIONS | LANGUAGES | AWARDS | CUSTOM
// JobDescriptionSource: MANUAL | URL
// CoverLetterTone: PROFESSIONAL | FORMAL | CONVERSATIONAL | ENTHUSIASTIC | CONFIDENT
//   | CONCISE | CREATIVE | EXECUTIVE | FRIENDLY | STORYTELLING
// SubscriptionPlan: FREE | PRO | TEAM
// SubscriptionStatus: ACTIVE | TRIALING | PAST_DUE | CANCELED | INCOMPLETE | UNPAID
// AIFeature: RESUME_GENERATION | RESUME_REWRITE | BULLET_IMPROVEMENT | ATS_ANALYSIS
//   | COVER_LETTER_GENERATION | COVER_LETTER_REWRITE | COVER_LETTER_CUSTOMIZE | KEYWORD_EXTRACTION
//   | RESUME_PARSING | JOB_PARSING | RESUME_TAILORING | RESUME_REVIEW | SKILL_GAP_ANALYSIS
//   | RESUME_ASSISTANT_CHAT | INTERVIEW_QUESTION_GENERATION | INTERVIEW_ANSWER_EVALUATION
//   | INTERVIEW_REPORT
// ChatRole: USER | ASSISTANT
// InterviewType: RESUME | TECHNICAL | HR | BEHAVIORAL | MIXED
// InterviewDifficulty: EASY | MEDIUM | HARD
// InterviewFeedbackMode: AFTER_EACH_QUESTION | END_ONLY
// InterviewSessionStatus: IN_PROGRESS | COMPLETED | ABANDONED
// InterviewQuestionCategory: RESUME | TECHNICAL | HR | BEHAVIORAL
// HiringReadiness: BEGINNER | INTERMEDIATE | STRONG_CANDIDATE | INTERVIEW_READY
// JobApplicationStatus: SAVED | APPLIED | RESUME_VIEWED | ASSESSMENT | INTERVIEW_SCHEDULED
//   | INTERVIEW_COMPLETED | SECOND_INTERVIEW | FINAL_INTERVIEW | OFFER_RECEIVED | ACCEPTED
//   | REJECTED | WITHDRAWN | ARCHIVED
// JobApplicationSource: URL_IMPORT | MANUAL | TAILORING
// EmploymentType: FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP | FREELANCE | TEMPORARY
// WorkMode: ONSITE | REMOTE | HYBRID
// JobInterviewRoundStatus: PENDING | SCHEDULED | COMPLETED | CANCELED | RESCHEDULED
// MeetingPlatform: ZOOM | GOOGLE_MEET | MICROSOFT_TEAMS | PHONE | IN_PERSON | OTHER
// ApplicationTimelineEvent: APPLIED | RESUME_VIEWED | ASSESSMENT_SENT | INTERVIEW_SCHEDULED
//   | INTERVIEW_COMPLETED | OFFER_RECEIVED | STATUS_UPDATED | NOTE_ADDED | REJECTED | WITHDRAWN

model Resume {
  id         String   @id @default(uuid())
  userId     String
  title      String
  status     String   @default("DRAFT")
  templateId String   @default("CLASSIC")
  themeColor String   @default("SLATE")
  pageColor  String   @default("WHITE")
  pageSize   String   @default("A4")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections          ResumeSection[]
  versions          ResumeVersion[]
  reviews           ResumeReview[]
  coverLetters      CoverLetter[]
  skillGapAnalyses  SkillGapAnalysis[]
  aiJobs            AiJob[]
  conversations     Conversation[]
  interviewSessions InterviewSession[]
  jobApplications   JobApplication[]

  @@index([userId])
  @@map("resumes")
}

model ResumeSection {
  id        String   @id @default(uuid())
  resumeId  String
  type      String
  order     Int
  hidden    Boolean  @default(false)
  content   String   @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, order])
  @@index([resumeId])
  @@map("resume_sections")
}

model ResumeVersion {
  id            String   @id @default(uuid())
  resumeId      String
  versionNumber Int
  content       String   @db.NVarChar(Max)
  note          String?
  createdAt     DateTime @default(now())

  resume          Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobApplications JobApplication[]

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
  @@map("resume_versions")
}

model ResumeReview {
  id           String   @id @default(uuid())
  resumeId     String
  versionId    String?
  overallScore Int
  content      String   @db.NVarChar(Max)
  createdAt    DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("resume_reviews")
}

model SkillGapAnalysis {
  id               String   @id @default(uuid())
  resumeId         String
  versionId        String?
  jobDescriptionId String?
  overallScore     Int
  content          String   @db.NVarChar(Max)
  createdAt        DateTime @default(now())

  // JobDescription deletions must clear this reference at the application
  // layer before the delete: SQL Server disallows multiple cascading paths
  // reaching the same table, so this relation uses NoAction (see the
  // identical rule on CoverLetter.jobDescription).
  resume         Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([resumeId])
  @@map("skill_gap_analyses")
}

model CoverLetter {
  id               String   @id @default(uuid())
  userId           String
  resumeId         String?
  jobDescriptionId String?
  title            String
  content          String   @db.NVarChar(Max)
  pageColor        String   @default("WHITE")
  pageSize         String   @default("A4")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Resume and JobDescription deletions must clear these references at the
  // application layer before the delete: SQL Server disallows multiple
  // cascading paths reaching the same table, so these relations use NoAction.
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume            Resume?              @relation(fields: [resumeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobDescription    JobDescription?      @relation(fields: [jobDescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions          CoverLetterVersion[]
  interviewSessions InterviewSession[]
  jobApplications   JobApplication[]

  @@index([userId])
  @@index([resumeId])
  @@map("cover_letters")
}

model CoverLetterVersion {
  id            String   @id @default(uuid())
  coverLetterId String
  versionNumber Int
  title         String
  content       String   @db.NVarChar(Max)
  note          String?
  createdAt     DateTime @default(now())

  coverLetter CoverLetter @relation(fields: [coverLetterId], references: [id], onDelete: Cascade)

  @@unique([coverLetterId, versionNumber])
  @@index([coverLetterId])
  @@map("cover_letter_versions")
}

model JobDescription {
  id        String   @id @default(uuid())
  userId    String
  title     String
  company   String?
  content   String   @db.NVarChar(Max)
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverLetters      CoverLetter[]
  skillGapAnalyses  SkillGapAnalysis[]
  interviewSessions InterviewSession[]
  jobApplications   JobApplication[]

  @@index([userId])
  @@map("job_descriptions")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  plan                 String    @default("FREE")
  status               String    @default("ACTIVE")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AIUsage {
  id         String   @id @default(uuid())
  userId     String
  feature    String
  tokensUsed Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, feature])
  @@index([createdAt])
  @@map("ai_usages")
}

// Tracks long-running AI operations (tailoring, review, ATS analysis) so
// they can keep running server-side after the client navigates away, and so
// the client can reattach/poll for the result and notify the user on
// completion instead of the outcome being lost when the triggering fetch is
// abandoned.
// AiJobType: RESUME_TAILORING | RESUME_REVIEW | ATS_ANALYSIS
// AiJobStatus: PENDING | PROCESSING | COMPLETED | FAILED
model AiJob {
  id        String   @id @default(uuid())
  userId    String
  resumeId  String
  type      String
  status    String   @default("PENDING")
  input     String   @db.NVarChar(Max)
  result    String?  @db.NVarChar(Max)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resume deletions must clear this reference at the application layer
  // before the delete: SQL Server disallows multiple cascading paths
  // reaching the same table (User -> Resume -> AiJob and User -> AiJob), so
  // this relation uses NoAction (see the identical rule on
  // CoverLetter.resume / SkillGapAnalysis.jobDescription).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status])
  @@index([resumeId])
  @@map("ai_jobs")
}

// A chat session between a user and the AI Resume Assistant, scoped to a
// single resume (and optionally a specific past version). Holds ordered
// ChatMessage turns so a conversation can be reopened later (see
// .claude/roadmap/M19-ai-resume-assistant.md).
model Conversation {
  id        String   @id @default(uuid())
  userId    String
  resumeId  String
  versionId String?
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resume deletions must clear this reference at the application layer
  // before the delete: SQL Server disallows multiple cascading paths
  // reaching the same table (User -> Resume -> Conversation and
  // User -> Conversation), so this relation uses NoAction (see the
  // identical rule on AiJob.resume).
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume   Resume        @relation(fields: [resumeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages ChatMessage[]

  @@index([userId, resumeId])
  @@index([resumeId])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String   @db.NVarChar(Max)
  confidence     Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

// A mock interview session run against a specific resume, optionally
// grounded by a saved job description and/or cover letter (see
// .claude/roadmap/M20-Interview-questions.md). Reuses the same context
// sources as the AI Resume Assistant (Conversation) but tracks its own
// question/answer/evaluation state rather than a generic chat transcript,
// since every turn carries structured metadata (category, difficulty,
// score) used for the final report.
model InterviewSession {
  id               String    @id @default(uuid())
  userId           String
  resumeId         String
  versionId        String?
  jobDescriptionId String?
  coverLetterId    String?
  interviewType    String
  difficulty       String
  questionCount    Int?
  feedbackMode     String
  status           String    @default("IN_PROGRESS")
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  duration         Int?
  overallScore     Int?
  finalReport      String?   @db.NVarChar(Max)

  // Resume/JobDescription/CoverLetter deletions must clear these references
  // at the application layer before the delete: SQL Server disallows
  // multiple cascading paths reaching the same table (User -> X ->
  // InterviewSession and User -> InterviewSession directly), so these
  // relations use NoAction (see the identical rule on AiJob.resume /
  // SkillGapAnalysis.jobDescription / CoverLetter.resume).
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume              @relation(fields: [resumeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobDescription JobDescription?     @relation(fields: [jobDescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coverLetter    CoverLetter?        @relation(fields: [coverLetterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions      InterviewQuestion[]

  @@index([userId, resumeId])
  @@index([resumeId])
  @@map("interview_sessions")
}

model InterviewQuestion {
  id                     String    @id @default(uuid())
  interviewSessionId     String
  order                  Int
  question               String    @db.NVarChar(Max)
  category               String
  difficulty             String
  resumeSection          String?
  expectedSkills         String?   @db.NVarChar(Max)
  relatedProject         String?
  estimatedAnswerSeconds Int?
  userAnswer             String?   @db.NVarChar(Max)
  aiEvaluation           String?   @db.NVarChar(Max)
  score                  Int?
  createdAt              DateTime  @default(now())
  answeredAt             DateTime?

  interviewSession InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)

  @@unique([interviewSessionId, order])
  @@index([interviewSessionId])
  @@map("interview_questions")
}

// A single job application workspace (M21). Centralizes everything related
// to one application — job details, the resume/cover-letter versions used,
// notes, timeline, and interview rounds — so the user never has to search
// across pages. Reuses existing Resume/CoverLetter/JobDescription records by
// reference instead of duplicating their content (see conventions.md).
model JobApplication {
  id                   String    @id @default(uuid())
  userId               String
  company              String
  companyLogo          String?
  position             String
  location             String?
  salary               String?
  employmentType       String?
  workMode             String?
  status               String    @default("SAVED")
  source               String    @default("MANUAL")
  applicationDate      DateTime?
  deadline             DateTime?
  originalJobUrl       String?
  parsedJobDescription String?   @db.NVarChar(Max)
  notes                String?   @db.NVarChar(Max)
  resumeId             String?
  resumeVersionId      String?
  coverLetterId        String?
  jobDescriptionId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Resume/ResumeVersion/CoverLetter/JobDescription deletions must clear
  // these references at the application layer before the delete: SQL Server
  // disallows multiple cascading paths reaching the same table (User ->
  // Resume -> JobApplication and User -> JobApplication directly), so these
  // relations use NoAction (see the identical rule on AiJob.resume /
  // InterviewSession.resume).
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?               @relation(fields: [resumeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resumeVersion  ResumeVersion?        @relation(fields: [resumeVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coverLetter    CoverLetter?          @relation(fields: [coverLetterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobDescription JobDescription?       @relation(fields: [jobDescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interviews     JobInterview[]
  timeline       ApplicationTimeline[]

  @@index([userId])
  @@index([userId, status])
  @@map("job_applications")
}

// One interview round within a JobApplication. There is no limit on the
// number of rounds per application (see roadmap M21 "Interview Tracking").
model JobInterview {
  id               String    @id @default(uuid())
  applicationId    String
  roundNumber      Int
  interviewType    String
  status           String    @default("PENDING")
  scheduledDate    DateTime?
  scheduledTime    String?
  timezone         String?
  meetingPlatform  String?
  meetingLink      String?
  interviewerName  String?
  interviewerEmail String?
  location         String?
  notes            String?   @db.NVarChar(Max)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, roundNumber])
  @@index([applicationId])
  @@map("job_interviews")
}

// Chronological event log for a JobApplication (see roadmap M21
// "Application Timeline"). Append-only: events are never edited or deleted.
model ApplicationTimeline {
  id            String   @id @default(uuid())
  applicationId String
  event         String
  timestamp     DateTime @default(now())
  notes         String?

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_timeline")
}

// Records processed Stripe webhook event IDs so retried/duplicate deliveries
// (Stripe redelivers on timeout or non-2xx) are ignored instead of reapplied.
model StripeWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  createdAt     DateTime @default(now())

  @@map("stripe_webhook_events")
}
